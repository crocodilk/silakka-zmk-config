#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/*
 * -------------------------------------------------------------------------
 *  MODYFIKATORY (macOS, CAGS)
 *    home row lewa   A S D F  =  Ctrl  Option  Cmd   Shift
 *    home row prawa  J K L ;  =  Shift Cmd     Option Ctrl
 *
 *  Cmd i Option zostaja RUWNIEZ na kciukach - celowo. Kciuki nie podlegaja
 *  positional hold-tap, wiec Cmd+C / Cmd+V / Cmd+Z lewa reka dzialaja
 *  tylko przez kciukowy Cmd. Nie usuwaj ich.
 *
 *  RECE A WARSTWY
 *    LOWER (warstwa 1) trzyma PRAWY kciuk  -> symbole na LEWEJ rece
 *    RAISE (warstwa 2) trzyma LEWY  kciuk  -> kursory na PRAWEJ rece
 *
 *  Pozycje klawiszy (indeksy w tablicy bindings):
 *    rzad 0:  L 0-5     R 6-11
 *    rzad 1:  L 12-17   R 18-23
 *    rzad 2:  L 24-29   R 30-35
 *    rzad 3:  L 36-41   (42-43 puste)  R 44-49
 *    kciuki:  L 50-52   (53-54 puste)  R 55-57
 * -------------------------------------------------------------------------
 */

#define LEFT_HAND   0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define RIGHT_HAND  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49
#define THUMBS     50 51 52 55 56 57

/ {
    behaviors {
        /* Layer-tap dla kciukow: Space / Enter.
         * require-prior-idle-ms jest tu najwazniejszy - jesli wlasnie pisales,
         * klawisz jest traktowany jako tap, nie jako warstwa.
         */
        lt_bal: balanced_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /* Mod-tap bez ograniczen pozycyjnych - dla Esc/Ctrl na pinky. */
        mt_bal: balanced_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        /* Home row mod - LEWA reka. Hold wyzwoli sie tylko gdy nastepny
         * klawisz jest na PRAWEJ rece albo na kciuku.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <RIGHT_HAND THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Home row mod - PRAWA reka. */
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <LEFT_HAND THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp GRAVE             &kp N1        &kp N2       &kp N3       &kp N4        &kp N5                              &kp N6           &kp N7        &kp N8       &kp N9       &kp N0           &kp BACKSPACE
&kp TAB               &kp Q         &kp W        &kp E        &kp R         &kp T                               &kp Y            &kp U         &kp I        &kp O        &kp P            &kp PIPE
&mt_bal LCTRL ESCAPE  &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G                               &kp H            &hmr RSHFT J  &hmr RGUI K  &hmr RALT L  &hmr RCTRL SEMI  &kp SQT
&kp LSHIFT            &kp Z         &kp X        &kp C        &kp V         &kp B            &none    &none     &kp N            &kp M         &kp COMMA    &kp DOT      &kp FSLH         &kp RSHFT
                                                 &kp LALT     &kp LGUI      &lt_bal 2 SPACE  &none    &none     &lt_bal 1 ENTER  &kp BSPC      &kp RIGHT_ALT
            >;
        };

        /* ------------------------------------------------------------------
         * LOWER - warstwa symboli. Trzymana PRAWYM kciukiem (Enter),
         * wiec caly zestaw symboli siedzi na LEWEJ, wolnej rece.
         *
         *   Q W E R T  ->   `   <   [   ]   >
         *   A S D F G  ->   ~   -   (   )   =
         *   Z X C V B  ->   \   _   {   }   +
         *
         * Nawiasy stoja pionowo pod srodkowym i wskazujacym: [] / () / {}.
         * Kolumna 2 i 5 sa lustrzane: -/= na home row, _/+ pod spodem
         * (czyli shiftowane wersje dokladnie pod oryginalami).
         * PRAWA reka dubluje nawigacje z RAISE - identyczne bindingi, zeby
         * kursory byly dostepne niezaleznie od tego, ktory kciuk trzymasz.
         * Symboli (! @ # $ % ^ & * : " ?) tu nie ma celowo - to i tak
         * Shift+cos z warstwy bazowej, zero nowej funkcjonalnosci.
         *
         * Uwaga ergonomia: LOWER trzyma PRAWY kciuk, wiec nawigacja prawa reka
         * jest tu obsluga jedna reka (kciuk trzyma, palce jada). Wygodniejsza
         * wersja jest na RAISE, gdzie trzyma lewy kciuk i prawa reka jest wolna.
         *
         * Mody: nadpisanie prawego home row zabiera stamtad Shift/Cmd/Option/
         * Ctrl, ale wszystkie zostaja dostepne po LEWEJ przez &trans:
         *   Ctrl  - lewy pinky, home row  (-> mt_bal LCTRL ESCAPE)
         *   Shift - lewy pinky, rzad 3    (-> kp LSHIFT)
         *   Cmd   - lewy kciuk            (-> kp LGUI)
         *   Option- lewy kciuk            (-> kp LALT)
         * Dzieki temu Cmd+[ , Cmd+= , Ctrl+~ itd. nadal dzialaja.
         *
         * Rzad 0 zostaje na F1-F12. Prawy kciuk zostaje &trans (BSPC z bazy) -
         * DELETE z RAISE tu nie kopiujemy.
         * ------------------------------------------------------------------ */
        lower_layer {
            display-name = "Lower Layer";
            bindings = <
&kp F1  &kp F2         &kp F3            &kp F4                &kp F5                 &kp F6                              &kp F7        &kp F8         &kp F9        &kp F10          &kp F11        &kp F12
&trans  &kp GRAVE      &kp LESS_THAN     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GREATER_THAN                    &trans        &kp LA(LEFT)   &kp UP_ARROW  &kp LA(RIGHT)    &kp PAGE_UP    &trans
&trans  &kp TILDE      &kp MINUS         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL                           &kp LG(LEFT)  &kp LEFT       &kp DOWN      &kp RIGHT        &kp LG(RIGHT)  &trans
&trans  &kp BACKSLASH  &kp UNDERSCORE    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PLUS          &trans    &trans  &trans        &kp LG(UP)     &trans        &kp LG(DOWN)     &kp PAGE_DOWN  &trans
                                         &trans                &trans                 &trans            &trans    &trans  &trans        &trans         &trans
            >;
        };

        /* ------------------------------------------------------------------
         * RAISE - warstwa nawigacji. Trzymana LEWYM kciukiem (Space),
         * wiec kursory siedza na PRAWEJ, wolnej rece.
         *
         * Klasyczne odwrocone T (nie vimowe hjkl):
         *              I = gora
         *      J = lewo  K = dol  L = prawo
         *
         * Uklad kolumnowy (orto - kazda kolumna ma jeden sens):
         *   I / K       :  GORA / DOL
         *   U / J / M   :  slowo w lewo / znak w lewo / poczatek dokumentu
         *   O / L / .   :  slowo w prawo / znak w prawo / koniec dokumentu
         *   H  i  ;     :  poczatek / koniec linii (Cmd+strzalka), obok J i L
         *   P  i  /     :  PgUp / PgDn (kolumna pinky = duze skoki)
         *
         * Rzad 0 = F1-F12, identycznie jak na LOWER.
         *
         * Uwaga macOS: Home/End w wiekszosci aplikacji tylko przewijaja widok
         * i NIE ruszaja kursora - dlatego linie obsluguje Cmd+strzalka.
         *
         * LEWA reka home row zostaje &trans - dzieki temu dzialaja tu mody,
         * czyli Shift+strzalki (zaznaczanie), Cmd+Shift+strzalki itd.
         *   Q W E R T  -> pulpity / Mission Control / przelaczanie aplikacji
         *   Z X C V B  -> cofnij / wytnij / kopiuj / wklej / ponow
         * ------------------------------------------------------------------ */
        raise_layer {
            display-name = "Raise Layer";
            bindings = <
&kp F1  &kp F2          &kp F3          &kp F4          &kp F5           &kp F6                              &kp F7           &kp F8          &kp F9          &kp F10          &kp F11        &kp F12
&trans  &kp LC(LEFT)    &kp LC(UP)      &kp LC(RIGHT)   &kp LG(TAB)      &kp LG(GRAVE)                       &trans           &kp LA(LEFT)    &kp UP_ARROW    &kp LA(RIGHT)    &kp PAGE_UP    &trans
&trans  &trans          &trans          &trans          &trans           &trans                              &kp LG(LEFT)     &kp LEFT        &kp DOWN        &kp RIGHT        &kp LG(RIGHT)  &trans
&trans  &kp LG(Z)       &kp LG(X)       &kp LG(C)       &kp LG(V)        &kp LG(LS(Z))    &trans    &trans    &trans           &kp LG(UP)      &trans          &kp LG(DOWN)     &kp PAGE_DOWN  &trans
                                        &trans          &trans           &trans           &trans    &trans    &trans           &kp DELETE      &trans
            >;
        };

        settings_layer {
            display-name = "Settings Layer";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &kp C_PREV    &kp C_NEXT
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &kp K_VOL_UP  &kp C_PP
&trans      &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &kp K_VOL_DN  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans        &trans
                                        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
